# Only for running on your own machine. NEVER set this on a public deployment.
PROMPT_FORGE_LOCAL=1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Comma-separated: GitHub repo URL (optionally /tree/<branch>/<subfolder>), .zip link or local folder.
SKILL_SOURCES=https://github.com/Darkvus/dev-toolkit
# Only needed for private repos
GITHUB_TOKEN=
